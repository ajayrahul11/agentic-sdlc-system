# =====================================================================================================
# orchestrator/.env  (copy this file:  cp .env.example .env   |  Windows PowerShell: Copy-Item .env.example .env)
#
# MUST SET:    ANTHROPIC_API_KEY (or OPENAI_API_KEY + MODEL_PROVIDER=openai)
# CHECK:       JAVA_VERSION (must be <= the JDK `java -version` reports)
# OPTIONAL:    MAX_RUN_COST_USD (spend cap per run; works without it, defaults to 3.5 - see "Cost and latency guards")
# Everything else has a tested default; uncomment a line only to change it.
# After editing, run:  python -m sdlc_orchestrator doctor   (every row must say yes)
# =====================================================================================================

# ---- Model provider (pick one, set the matching key) ----
MODEL_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Cost and latency guards (a run can never loop past these) ----
# OPTIONAL but RECOMMENDED: your spend ceiling per run, in US dollars. If you leave this line commented out the built-in
# default of 3.5 applies. Every model call is priced from its token usage and, once the running total reaches this value,
# NO further call is made and the run stops with "LLM budget exhausted" (it survives pause/resume). A normal greenfield
# run costs roughly $0.5 to $1.5. Uncomment and lower it if you have a tight budget, e.g. 2.0
# MAX_RUN_COST_USD=3.5
LLM_TIMEOUT_SECONDS=240           # per-request HTTP timeout: a hung API call fails fast instead of stalling a run
LLM_MAX_ATTEMPTS=4                # attempts per LLM call on transient API errors (exponential backoff); errors cost no tokens
# LLM_TEMPERATURE=                # optional; unset = provider default

# ---- Per-stage model routing (cheap model where output is validated deterministically, strong model where an error is expensive) ----
# Defaults shown; uncomment to override. Any stage: MODEL_<STAGE>; escalated retry model: MODEL_<STAGE>_ESCALATED.
# MODEL_REQUIREMENTS=claude-sonnet-5-5
# MODEL_CODEBASE_REASONING=claude-haiku-4-5-20251001   # every named path is checked against disk
# MODEL_DECOMPOSITION=claude-haiku-4-5-20251001        # DAG validated deterministically + canonical-plan fallback
# MODEL_DESIGN=claude-sonnet-5-5                       # compact JSON contract (OpenAPI, migrations, component plan, ADRs)
# MODEL_DESIGN_DOC=claude-sonnet-5-5                   # the markdown design document (separate call so JSON never overflows)
# MODEL_CODEGEN=claude-sonnet-5-5                      # first attempt
# MODEL_CODEGEN_ESCALATED=claude-opus-5-5              # used once ESCALATE_AFTER_FAILURES attempts have failed
# MODEL_JSON_REPAIR=claude-haiku-4-5-20251001          # reformats an unparseable JSON reply
ESCALATE_AFTER_FAILURES=2         # failed attempts (per plan version) before codegen moves to MODEL_CODEGEN_ESCALATED
PROMPT_CACHING=true               # Anthropic prompt caching of the system prompt + design prefix
# Claude 5 models think adaptively and thinking tokens count against max_tokens, so reasoning effort is capped per stage
# (default low; codegen medium). Override per stage: LLM_EFFORT_<STAGE>=low|medium|high
# LLM_EFFORT_DESIGN=low
# LLM_EFFORT_CODEGEN=medium

# ---- Orchestrator state store (LangGraph checkpointer + audit event log) ----
# Postgres (recommended) - `docker compose -f ../docker-compose.yml up -d` starts it on host port 5433.
# Zero-infra alternative: CHECKPOINTER=sqlite and EVENT_SINK=jsonl (files under RUNS_DIR).
CHECKPOINTER=postgres             # postgres | sqlite | memory
EVENT_SINK=postgres               # postgres | jsonl | memory
ORCHESTRATOR_DB_URL=postgresql://orchestrator:orchestrator@localhost:5433/orchestrator
# RUNS_DIR=runs                   # run artefacts (design review files, sqlite/jsonl state); default ./runs

# ---- LangSmith tracing (optional; the audit log does not depend on it) ----
LANGCHAIN_TRACING_V2=false        # set true and add LANGCHAIN_API_KEY to send traces to LangSmith
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-sdlc-system
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- The product the orchestrator BUILDS (does not exist until the greenfield run creates it) ----
TARGET_REPO_PATH=../url-shortener-service
# JDK used for the generated project. Must be <= the JDK installed locally (`java -version`).
# 21 is recommended for Spring Boot 4; use 17 if that is what you have.
# (If your JAVA_HOME points at an older JDK than JAVA_VERSION but a newer one is on PATH, the orchestrator ignores JAVA_HOME for Maven.)
JAVA_VERSION=21
# Leave empty = latest GA Spring Boot from start.spring.io. Pin only if you must (e.g. 4.1.1).
SPRING_BOOT_VERSION=
MIN_SPRING_BOOT_MAJOR=4           # the scaffold step refuses anything older than this Spring Boot major version
# INITIALIZR_URL=https://start.spring.io
# OFFLINE_TARGET_REPO_PATH=./.offline-target/url-shortener-service   # sandbox used by --offline; the real target is never touched offline

# ---- Governance / reliability knobs ----
MAX_RETRIES_PER_NODE=2            # in-place retries of implementation before rollback
FALLBACK_AFTER_FAILURES=2         # switch to the simpler codegen strategy after this many failed attempts
MAX_REPLANS=1                     # upstream Design re-runs allowed per run
MAX_CLARIFICATION_ROUNDS=3        # times the human is asked to clarify; then proceed on logged assumptions
MAX_DESIGN_REVISIONS=5            # 'revise' rounds at the design gate; then the run aborts
RETRY_BACKOFF_BASE_SECONDS=2      # exponential: 2, 4, 8 ... capped at RETRY_BACKOFF_CAP_SECONDS
RETRY_BACKOFF_CAP_SECONDS=30
MAVEN_TIMEOUT_SECONDS=900
# GRAPH_RECURSION_LIMIT=120       # hard ceiling on graph steps per run (safety net against loops)
DEPLOY_VERIFY=true                # after tests pass: docker compose build + up + smoke-test the live APIs (needs Docker and a free host port 8080)
# NOTE: there is intentionally NO setting to bypass the release-approval or design-approval gate.
