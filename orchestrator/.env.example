# ---- Model provider (pick one, set the matching key) ----
MODEL_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional per-stage model override (efficient model routing), e.g. MODEL_CODEGEN=claude-opus-5-5
# MODEL_REQUIREMENTS=
# MODEL_DESIGN=
# MODEL_CODEGEN=

# ---- Orchestrator state store (LangGraph checkpointer + audit event log) ----
# Postgres (document recommendation) - `docker compose up -d` starts it on host port 5433
CHECKPOINTER=postgres             # postgres | sqlite | memory
EVENT_SINK=postgres               # postgres | jsonl | memory
ORCHESTRATOR_DB_URL=postgresql://orchestrator:orchestrator@localhost:5433/orchestrator

# ---- LangSmith tracing (optional; the audit log does not depend on it) ----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-sdlc-url-shortener
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- The product the orchestrator BUILDS (does not exist until the greenfield run creates it) ----
TARGET_REPO_PATH=../url-shortener-service
# JDK used for the generated project. Must be <= the JDK installed locally (`java -version`).
# 21 is recommended for Spring Boot 4; use 17 if that is what you have.
JAVA_VERSION=17
# Leave empty = latest GA Spring Boot from start.spring.io. Pin only if you must (e.g. 4.1.1).
SPRING_BOOT_VERSION=
MIN_SPRING_BOOT_MAJOR=4

# ---- Governance / reliability knobs ----
MAX_RETRIES_PER_NODE=2            # in-place retries of implementation before rollback
FALLBACK_AFTER_FAILURES=2         # switch to the simpler codegen strategy after this many failed attempts
MAX_REPLANS=1                     # upstream Design re-runs allowed per run
RETRY_BACKOFF_BASE_SECONDS=2      # exponential: 2, 4, 8 ... capped at RETRY_BACKOFF_CAP_SECONDS
RETRY_BACKOFF_CAP_SECONDS=30
MAVEN_TIMEOUT_SECONDS=900
# NOTE: there is intentionally NO setting to bypass the release-approval gate.
